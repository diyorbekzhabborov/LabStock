<Window x:Class="LabStock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LabStock.ViewModels"
        mc:Ignorable="d"
        Title="LabStock — Система управления запасами медицинской лаборатории" 
        Height="850" Width="1350" MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Nav Button Style -->
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0F2FE"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryDark}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Login View Overlay when logged out -->
        <ContentControl Content="{Binding LoginVM}" Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Panel.ZIndex="100"/>

        <!-- Main Application Shell when Authenticated -->
        <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT NAVIGATION SIDEBAR -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- App Brand Header -->
                    <Border Grid.Row="0" Padding="18,18,18,14" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="{StaticResource PrimaryColor}" Margin="0,0,12,0">
                                <TextBlock Text="⚕" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="LabStock" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryDark}"/>
                                <TextBlock Text="Мед. Лаборатория v1.0" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Navigation Items List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,10">
                        <StackPanel>
                            <!-- Section: Главное -->
                            <TextBlock Text="ОСНОВНОЕ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="8,8,0,6"/>

                            <RadioButton Content="📊 Главная / Dashboard" Style="{StaticResource NavButton}"
                                         IsChecked="{Binding CurrentViewName, Converter={x:Null}, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>

                            <RadioButton Content="⚡ Выполнить анализ" Style="{StaticResource NavButton}"
                                         Command="{Binding NavigateCommand}" CommandParameter="RunAnalysis"/>

                            <RadioButton Content="📦 Склад и остатки" Style="{StaticResource NavButton}"
                                         Command="{Binding NavigateCommand}" CommandParameter="Warehouse"/>

                            <!-- Section: Операции -->
                            <TextBlock Text="СКЛАДСКИЕ ОПЕРАЦИИ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="8,16,0,6"/>

                            <RadioButton Content="📥 Поступления (Приход)" Style="{StaticResource NavButton}"
                                         Command="{Binding NavigateCommand}" CommandParameter="Receipts"/>

                            <RadioButton Content="📤 Ручные списания" Style="{StaticResource NavButton}"
                                         Command="{Binding NavigateCommand}" CommandParameter="Writeoffs"/>

                            <RadioButton Content="🔄 Движение склада" Style="{StaticResource NavButton}"
                                         Command="{Binding NavigateCommand}" CommandParameter="Movements"/>

                            <RadioButton Content="⚖️ Инвентаризация" Style="{StaticResource NavButton}"
                                         Command="{Binding NavigateCommand}" CommandParameter="InventoryCheck"/>

                            <!-- Section: Справочники -->
                            <TextBlock Text="СПРАВОЧНИКИ И НОРМЫ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="8,16,0,6"/>

                            <RadioButton Content="🧪 Материалы и реагенты" Style="{StaticResource NavButton}"
                                         Command="{Binding NavigateCommand}" CommandParameter="Materials"/>

                            <RadioButton Content="📋 Анализы и нормы расхода" Style="{StaticResource NavButton}"
                                         Command="{Binding NavigateCommand}" CommandParameter="Analyses"/>

                            <RadioButton Content="🏢 Поставщики" Style="{StaticResource NavButton}"
                                         Command="{Binding NavigateCommand}" CommandParameter="Suppliers"/>

                            <!-- Section: Аналитика и Контроль -->
                            <TextBlock Text="АНАЛИТИКА И СИСТЕМА" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="8,16,0,6"/>

                            <!-- Notifications with Badge -->
                            <RadioButton Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Notifications">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔔 Уведомления" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="#DC2626" CornerRadius="10" Padding="7,2" Margin="6,0,0,0"
                                            Visibility="{Binding UnreadNotificationsCount, Converter={StaticResource ZeroToCollapsedConverter}}">
                                        <TextBlock Text="{Binding UnreadNotificationsCount}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </Grid>
                            </RadioButton>

                            <RadioButton Content="📈 Отчёты (PDF / Excel)" Style="{StaticResource NavButton}"
                                         Command="{Binding NavigateCommand}" CommandParameter="Reports"/>

                            <RadioButton Content="🛡️ Журнал аудита" Style="{StaticResource NavButton}"
                                         Command="{Binding NavigateCommand}" CommandParameter="AuditLog"/>

                            <RadioButton Content="👥 Пользователи" Style="{StaticResource NavButton}"
                                         Visibility="{Binding CanManageUsers, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         Command="{Binding NavigateCommand}" CommandParameter="Users"/>

                            <RadioButton Content="⚙️ Настройки и бэкап" Style="{StaticResource NavButton}"
                                         Visibility="{Binding CanManageSettings, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom User Card & Logout -->
                    <Border Grid.Row="2" Padding="14" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0" Background="#F8FAFC">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#E0F2FE">
                                <TextBlock Text="👤" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentUserFullName}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding CurrentUserRole}" FontSize="10" Foreground="{StaticResource PrimaryColor}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Выход" Command="{Binding LogoutCommand}" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT MAIN WORKSPACE -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Quick Action Bar (Barcode Scanner input & Info) -->
                <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="24,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Quick Barcode / QR Scanner Input -->
                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding QuickBarcode, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="34" Padding="8,6" FontSize="12" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Column="0" Text="Сканировать QR / Штрихкод..." FontSize="12" Foreground="{StaticResource TextMuted}" 
                                       IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding QuickBarcode, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                            <Button Grid.Column="1" Content="Поиск" Command="{Binding BarcodeLookupCommand}" Style="{StaticResource SecondaryButton}" Height="34" Margin="6,0,0,0"/>
                        </Grid>

                        <!-- Mode info -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#DCFCE7" CornerRadius="4" Padding="8,3" Margin="0,0,12,0">
                                <TextBlock Text="🟢 Автономный режим (Offline SQLite)" FontSize="11" FontWeight="SemiBold" Foreground="#15803D"/>
                            </Border>
                            <Border Background="#E0F2FE" CornerRadius="4" Padding="8,3">
                                <TextBlock Text="✓ Алгоритм FEFO активен" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDark}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Active View Content Host -->
                <ContentPresenter Grid.Row="1" Content="{Binding CurrentView}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
