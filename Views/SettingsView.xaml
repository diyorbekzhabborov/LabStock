<UserControl x:Class="LabStock.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100" Background="#F8FAFC">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Настройки системы и резервное копирование" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Конфигурация параметров лаборатории, сроков годности и управление бэкапами базы данных" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Status Banner -->
            <Border Grid.Row="1" CornerRadius="6" Padding="12" Margin="0,0,0,16"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#DCFCE7"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                <Setter Property="Background" Value="#FEE2E2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#15803D"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                    <Setter Property="Foreground" Value="#B91C1C"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <!-- Settings Grid -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Card: General & Inventory settings -->
                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Параметры лаборатории" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryDark}" Margin="0,0,0,16"/>

                        <!-- Lab Name -->
                        <TextBlock Text="Наименование лаборатории (для отчётов):" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding LabName, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,14"/>

                        <!-- Currency -->
                        <TextBlock Text="Основная валюта учета:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Currency, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,14"/>

                        <!-- Expiry Days Alert Threshold -->
                        <TextBlock Text="Порог предупреждения о приближении срока годности (дней):" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding ExpiryDaysOptions}" SelectedItem="{Binding ExpiryAlertDays}" Height="36" Margin="0,0,0,14"/>

                        <!-- Negative Stock Setting -->
                        <Border Background="#F1F5F9" CornerRadius="6" Padding="12" Margin="0,0,0,20">
                            <StackPanel>
                                <CheckBox Content="Разрешать отрицательный остаток при списании" IsChecked="{Binding AllowNegativeStock}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="По умолчанию отключено для строгого контроля наличия реагентов на складе." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="20,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Button Content="💾 Сохранить параметры" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" Height="40" FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- Right Card: Backup & Restore -->
                <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="20" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Резервное копирование (Backup &amp; Restore)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryDark}" Margin="0,0,0,16"/>

                        <TextBlock Text="Создание мгновенной резервной копии базы данных SQLite со всеми остатками, анализами и историей движений:" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <!-- Backup Button -->
                        <Button Content="💾 Создать резервную копию (Backup)" Command="{Binding CreateBackupCommand}" Style="{StaticResource PrimaryButton}" Height="42" Margin="0,0,0,16"/>

                        <Separator Background="{StaticResource BorderLight}" Margin="0,0,0,16"/>

                        <!-- Restore Section with Warning -->
                        <TextBlock Text="Восстановление базы данных из файла:" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                        <Border Background="#FFFBEB" BorderBrush="#FEF08A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="⚠️ Внимание перед восстановлением!" FontWeight="Bold" Foreground="#B45309" FontSize="12"/>
                                <TextBlock Text="Восстановление заменит текущую базу данных данными из выбранного файла бэкапа. Перед заменой система автоматически создаст аварийный страховочный снимок текущей базы." 
                                           FontSize="11" Foreground="#92400E" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Button Content="📥 Восстановить из файла резервной копии..." Command="{Binding RestoreBackupCommand}" Style="{StaticResource DangerButton}" Height="42"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
