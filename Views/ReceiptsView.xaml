<UserControl x:Class="LabStock.Views.ReceiptsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100" Background="#F8FAFC">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Поступления материалов (Приход)" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Регистрация накладных от поставщиков, формирование партий и оприходование на склад" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="➕ Новое поступление (Приход)" Command="{Binding OpenCreateCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                <Button Content="🔄 Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
        </Grid>

        <!-- Receipts DataGrid -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Receipts}" SelectedItem="{Binding SelectedReceipt, Mode=TwoWay}"
                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№ Накладной" Binding="{Binding ReceiptNumber}" Width="150"/>
                    <DataGridTextColumn Header="Дата поступления" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="140"/>
                    <DataGridTextColumn Header="Поставщик" Binding="{Binding Supplier.Name}" Width="2*"/>
                    <DataGridTextColumn Header="Позиций" Binding="{Binding Items.Count}" Width="80"/>
                    <DataGridTextColumn Header="Сумма закупки" Binding="{Binding TotalAmount, StringFormat={}{0:N2} сомони}" Width="150"/>
                    <DataGridTextColumn Header="Принял сотрудник" Binding="{Binding User.FullName}" Width="1.5*"/>
                    <DataGridTextColumn Header="Примечание" Binding="{Binding Notes}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Create Receipt Modal Overlay -->
        <Grid Grid.RowSpan="2" Background="#80000000" Visibility="{Binding IsCreateOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <Border Width="850" MaxHeight="680" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="White" CornerRadius="12" Padding="28"
                    BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.2"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Оформление поступления на склад" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryDark}"/>
                        <Button Content="✕" Command="{Binding CancelCreateCommand}" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Padding="8,4" BorderThickness="0"/>
                    </Grid>

                    <!-- Header Inputs -->
                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Номер накладной:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding ReceiptNumber, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Дата документа:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding ReceiptDate}" Height="36"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Поставщик:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Suppliers}" SelectedValue="{Binding SelectedSupplierId}" SelectedValuePath="Id" DisplayMemberPath="Name"/>
                        </StackPanel>
                    </Grid>

                    <!-- Items Table -->
                    <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="Товарные позиции и партии:" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                <Button Content="➕ Добавить строку" Command="{Binding AddDraftItemCommand}" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11"/>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding DraftItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" CornerRadius="6" Padding="8" Margin="0,0,0,6" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="1.2*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Material selector -->
                                                    <ComboBox Grid.Column="0" ItemsSource="{Binding DataContext.Materials, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              SelectedValue="{Binding MaterialId, Mode=TwoWay}" SelectedValuePath="Id" DisplayMemberPath="Name" Height="32"/>

                                                    <!-- Lot Number -->
                                                    <TextBox Grid.Column="2" Text="{Binding LotNumber, UpdateSourceTrigger=PropertyChanged}" Height="32"/>

                                                    <!-- Quantity -->
                                                    <TextBox Grid.Column="4" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Height="32"/>

                                                    <!-- Price -->
                                                    <TextBox Grid.Column="6" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" Height="32"/>

                                                    <!-- Expiry Date -->
                                                    <DatePicker Grid.Column="8" SelectedDate="{Binding ExpiryDate}" Height="32"/>

                                                    <!-- Remove Button -->
                                                    <Button Grid.Column="10" Content="✕" 
                                                            Command="{Binding DataContext.RemoveDraftItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButton}" Padding="8,4" Height="32"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Footer & Confirmation -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Примечание:" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
                            <Button Content="Отмена" Command="{Binding CancelCreateCommand}" Style="{StaticResource SecondaryButton}" Height="38" Margin="0,0,8,0"/>
                            <Button Content="📥 Оприходовать на склад" Command="{Binding SaveReceiptCommand}" Style="{StaticResource PrimaryButton}" Height="38"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
