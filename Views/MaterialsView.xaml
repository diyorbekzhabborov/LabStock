<UserControl x:Class="LabStock.Views.MaterialsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100" Background="#F8FAFC">
    <Grid Margin="24">
        <!-- Main Table & Actions -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Справочник материалов и реагентов" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Каталог расходных позиций лаборатории, нормы запасов и параметры хранения" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="➕ Добавить материал" Command="{Binding OpenCreateCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                <Button Content="✏️ Редактировать" Command="{Binding OpenEditCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button Content="🗑️ Удалить" Command="{Binding DeleteCommand}" Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
        </Grid>

        <!-- Search Bar -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="36" VerticalContentAlignment="Center"/>
                <TextBlock Text="🔍 Поиск по названию, артикулу, штрихкоду..." FontSize="12" Foreground="{StaticResource TextMuted}" 
                           IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center"
                           Visibility="{Binding SearchText, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                <Button Grid.Column="1" Content="🔄 Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Height="36"/>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Materials}" SelectedItem="{Binding SelectedMaterial, Mode=TwoWay}"
                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Артикул" Binding="{Binding Article}" Width="110"/>
                    <DataGridTextColumn Header="Штрихкод" Binding="{Binding Barcode}" Width="120"/>
                    <DataGridTextColumn Header="Наименование материала" Binding="{Binding Name}" Width="2.5*"/>
                    <DataGridTextColumn Header="Категория" Binding="{Binding Category.Name}" Width="1.5*"/>
                    <DataGridTextColumn Header="Ед. изм." Binding="{Binding Unit.ShortName}" Width="70"/>
                    <DataGridTextColumn Header="Мин. порог" Binding="{Binding MinQuantity, StringFormat={}{0:0.##}}" Width="90"/>
                    <DataGridTextColumn Header="Макс. порог" Binding="{Binding MaxQuantity, StringFormat={}{0:0.##}}" Width="90"/>
                    <DataGridTextColumn Header="Место хранения" Binding="{Binding StorageLocation}" Width="1.5*"/>
                    <DataGridTextColumn Header="Поставщик" Binding="{Binding Supplier.Name}" Width="1.5*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Editor Modal Overlay -->
        <Grid Grid.RowSpan="3" Background="#80000000" Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <Border Width="650" MaxHeight="650" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="White" CornerRadius="12" Padding="28"
                    BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.2"/>
                </Border.Effect>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Modal Title -->
                        <Grid Margin="0,0,0,20">
                            <TextBlock Text="Новый расходный материал" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryDark}"
                                       Visibility="{Binding IsNew, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="Редактирование материала" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryDark}"
                                       Visibility="{Binding IsNew, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                            <Button Content="✕" Command="{Binding CancelEditCommand}" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Padding="8,4" BorderThickness="0"/>
                        </Grid>

                        <!-- Name -->
                        <TextBlock Text="Наименование (полное):" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,14"/>

                        <!-- Category & Unit -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Категория:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding Categories}" SelectedValue="{Binding EditCategoryId}" SelectedValuePath="Id" DisplayMemberPath="Name"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Единица измерения:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding Units}" SelectedValue="{Binding EditUnitId}" SelectedValuePath="Id" DisplayMemberPath="Name"/>
                            </StackPanel>
                        </Grid>

                        <!-- Article & Barcode -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Артикул / Заводской код:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditArticle, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Штрихкод / QR (необязательно):" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditBarcode, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                            </StackPanel>
                        </Grid>

                        <!-- Min & Max thresholds -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Мин. порог предупреждения:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditMinQuantity, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Макс. рекомендуемый запас:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditMaxQuantity, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                            </StackPanel>
                        </Grid>

                        <!-- Supplier & Location -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Основной поставщик:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding Suppliers}" SelectedValue="{Binding EditSupplierId}" SelectedValuePath="Id" DisplayMemberPath="Name"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Место хранения (стеллаж/полка):" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditStorageLocation, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                            </StackPanel>
                        </Grid>

                        <!-- Initial Stock (Only for new material) -->
                        <Border Background="#F1F5F9" CornerRadius="8" Padding="14" Margin="0,0,0,14"
                                Visibility="{Binding IsNew, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Ввод начального остатка (опционально):" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryDark}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Нач. количество:" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding InitialStock, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Цена закупки (сом.):" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding InitialPrice, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Срок годности:" FontSize="11" Margin="0,0,0,4"/>
                                        <DatePicker SelectedDate="{Binding InitialExpiry}" Height="34"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Description -->
                        <TextBlock Text="Описание / Примечания:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" Height="50" TextWrapping="Wrap" Margin="0,0,0,20"/>

                        <!-- Action Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Отмена" Command="{Binding CancelEditCommand}" Style="{StaticResource SecondaryButton}" Height="40"/>
                            <Button Grid.Column="2" Content="Сохранить" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Height="40"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
