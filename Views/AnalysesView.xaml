<UserControl x:Class="LabStock.Views.AnalysesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100" Background="#F8FAFC">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="240"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Справочник анализов и нормы расхода" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Конфигурация состава расходников для автоматического списания при проведении анализов" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="➕ Добавить анализ" Command="{Binding OpenCreateCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                <Button Content="✏️ Настроить нормы" Command="{Binding OpenEditCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button Content="🔄 Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
        </Grid>

        <!-- Analyses DataGrid -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Margin="0,0,0,14">
            <DataGrid ItemsSource="{Binding Analyses}" SelectedItem="{Binding SelectedAnalysis, Mode=TwoWay}"
                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Код анализа" Binding="{Binding Code}" Width="120"/>
                    <DataGridTextColumn Header="Наименование анализа" Binding="{Binding Name}" Width="2.5*"/>
                    <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="1.5*"/>
                    <DataGridTextColumn Header="Стоимость исследования" Binding="{Binding Price, StringFormat={}{0:N2} сомони}" Width="160"/>
                    <DataGridTextColumn Header="Позиций в рецепте" Binding="{Binding Materials.Count}" Width="130"/>
                    <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Bottom Panel: Recipe Details for Selected Analysis -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Нормы расхода на 1 анализ для: " FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Text="{Binding SelectedAnalysis.Name}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PrimaryDark}" Margin="6,0,0,0"/>
                </StackPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedAnalysis.Materials}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Расходный материал" Binding="{Binding Material.Name}" Width="3*"/>
                        <DataGridTextColumn Header="Норма расхода на 1 анализ" Binding="{Binding RequiredQuantity, StringFormat={}{0:0.##}}" Width="200"/>
                        <DataGridTextColumn Header="Единица измерения" Binding="{Binding Material.Unit.ShortName}" Width="140"/>
                        <DataGridTextColumn Header="Место хранения" Binding="{Binding Material.StorageLocation}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Editor Modal Overlay -->
        <Grid Grid.RowSpan="3" Background="#80000000" Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <Border Width="700" MaxHeight="660" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="White" CornerRadius="12" Padding="28"
                    BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.2"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Настройка анализа и норм расхода" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryDark}"/>
                        <Button Content="✕" Command="{Binding CancelEditCommand}" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Padding="8,4" BorderThickness="0"/>
                    </Grid>

                    <!-- Inputs -->
                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Код:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditCode, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Название анализа:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Категория:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditCategory, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Цена (сом.):" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditPrice, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                        </StackPanel>
                    </Grid>

                    <!-- Recipe Builder -->
                    <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="8" Padding="14" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="Добавить расходник в состав:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                    <ComboBox ItemsSource="{Binding AllMaterials}" SelectedValue="{Binding SelectedMaterialIdToAdd}" SelectedValuePath="Id" DisplayMemberPath="Name" Width="260" Height="32"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="➕ Добавить" Command="{Binding AddMaterialToRecipeCommand}" Style="{StaticResource SecondaryButton}" Padding="10,4" Height="32"/>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding EditRecipe}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" CornerRadius="6" Padding="8,6" Margin="0,0,0,6" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="40"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding MaterialName}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding UnitName}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="12"/>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Норма: " FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                                        <TextBox Text="{Binding RequiredQuantity, UpdateSourceTrigger=PropertyChanged}" Width="50" Height="28" HorizontalContentAlignment="Center"/>
                                                    </StackPanel>

                                                    <Button Grid.Column="3" Content="✕" 
                                                            Command="{Binding DataContext.RemoveMaterialFromRecipeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButton}" Padding="6,2" Height="28"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Footer Action Buttons -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Отмена" Command="{Binding CancelEditCommand}" Style="{StaticResource SecondaryButton}" Height="40"/>
                        <Button Grid.Column="2" Content="Сохранить анализ и нормы" Command="{Binding SaveAnalysisCommand}" Style="{StaticResource PrimaryButton}" Height="40"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
