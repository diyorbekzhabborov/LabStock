<UserControl x:Class="LabStock.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000" Background="#F1F5F9">
    <Grid>
        <Border Width="460" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="White" CornerRadius="12" Padding="36"
                BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.08" Color="#0F172A"/>
            </Border.Effect>

            <StackPanel>
                <!-- Logo & Header -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Border Width="60" Height="60" CornerRadius="30" Background="#E0F2FE" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="⚕" FontSize="32" Foreground="{StaticResource PrimaryColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="LabStock" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PrimaryDark}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Система управления запасами лаборатории" FontSize="13" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Error Message -->
                <Border Background="#FEE2E2" CornerRadius="6" Padding="10" Margin="0,0,0,16"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontSize="12" TextWrapping="Wrap" FontWeight="SemiBold"/>
                </Border>

                <!-- Username -->
                <TextBlock Text="Имя пользователя (Логин):" FontWeight="SemiBold" Margin="0,0,0,6" FontSize="12"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Height="40" Margin="0,0,0,16"/>

                <!-- Password -->
                <TextBlock Text="Пароль:" FontWeight="SemiBold" Margin="0,0,0,6" FontSize="12"/>
                <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Height="40" Margin="0,0,0,20"/>

                <!-- Login Button -->
                <Button Content="Войти в систему" Command="{Binding LoginCommand}" Style="{StaticResource PrimaryButton}" Height="44" FontSize="14"/>

                <Separator Margin="0,24,0,16" Background="{StaticResource BorderLight}"/>

                <!-- Fast Demo Users Selector -->
                <TextBlock Text="Быстрый вход для тестирования ролей:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding DemoUsers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SecondaryButton}" Margin="0,3" Height="36" HorizontalContentAlignment="Stretch"
                                    Command="{Binding DataContext.SelectDemoUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="12"/>
                                    <Border Grid.Column="1" Background="#E2E8F0" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{Binding RoleBadge}" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
